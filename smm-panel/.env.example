# --- Database (Neon / Vercel Postgres) ---
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# --- Provider ---
# "mock" uses in-memory sample data (safe default for local dev / demos).
# "live" calls the real https://smmcost.com/api/v2 using SMMCOST_API_KEY below.
PROVIDER_MODE="mock"
SMMCOST_API_URL="https://smmcost.com/api/v2"
SMMCOST_API_KEY="__NEVER_COMMIT_REAL_KEY__"

# --- Cron ---
# Vercel automatically sends this as a Bearer token to your cron routes
# when this env var is set — see https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs
CRON_SECRET="generate-a-random-string"

# --- Telegram bot ---
# Get TELEGRAM_BOT_TOKEN from @BotFather on Telegram (/newbot).
TELEGRAM_BOT_TOKEN="123456:ABC-your-bot-token"
# Any random string you choose — Telegram echoes it back on every webhook
# call so we can verify the request really came from Telegram. Generate
# with e.g. `openssl rand -hex 24`.
TELEGRAM_WEBHOOK_SECRET="generate-a-random-string"
# Your own Telegram chat id (message @userinfobot to get it) — used to
# gate admin-only bot commands like /sync.
TELEGRAM_ADMIN_CHAT_ID=""
